# Copy to .env.cync-lan and fill in. Loaded by scripts/run-cync-lan.sh.
# Mirrors github.com/baudneo/cync-lan (python branch) docker/example.env,
# adjusted to run bare-metal out of this repo instead of in the container.

# Required for the device-export web app (http://127.0.0.1:23778).
CYNC_ACCOUNT_USERNAME="cync-account-email@gmail.com"
CYNC_ACCOUNT_PASSWORD="cync-account-password"

# Required whenever the exporter is enabled (default): encrypts the Cync
# cloud access token at rest. Any unique random string is fine.
CYNC_SECRET_KEY="change-me-to-a-random-string"

# Keeps cync-lan's config/certs inside this repo instead of /root/cync-lan.
CYNC_BASE_DIR="./cync-lan-config"
CYNC_CFGAPPEND_DIR=""
CYNC_DEVICE_CERT="./cync-lan-config/certs/cert.pem"
CYNC_DEVICE_KEY="./cync-lan-config/certs/key.pem"

# The bare-metal mosquitto broker from scripts/run-mqtt.sh.
CYNC_MQTT_HOST="localhost"
CYNC_MQTT_PORT=1883
# Must match MQTT_BASE_TOPIC in docker-compose.yml's vecna service (both
# default to cync_lan, so this is only here for visibility).
CYNC_TOPIC="cync_lan"
