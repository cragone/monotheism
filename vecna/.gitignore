# Logs
logs
*.log
npm-debug.log*

# Frontend build output / deps (NOT server/web/dist, which holds the
# committed placeholder the Go binary embeds until a real build overwrites
# it — see server/web/embed.go)
/node_modules
/dist
/dist-ssr
*.local
.vite/

# Go runtime data (sqlite file, created at DATA_DIR)
server/data/
*.sqlite

# Bare-metal cync-lan checkout + venv (scripts/setup-cync-lan.sh), local
# mosquitto persistence, and secrets — alternative to the Docker services.
cync-lan-src/
mqtt-data/
.env.cync-lan

# cync-lan's exported device list, cloud access keys, and generated TLS
# certs — never commit these. docker-compose.yml bind-mounts this same dir.
cync-lan-config/*
!cync-lan-config/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
