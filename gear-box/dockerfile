FROM node:20-alpine AS frontend-build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

FROM golang:1.26-alpine AS server-build
WORKDIR /app
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ .
COPY --from=frontend-build /app/dist ./web/dist
RUN CGO_ENABLED=0 GOOS=linux go build -o /gear-box-server ./cmd/server

# Piper's official releases bundle their own libonnxruntime/libpiper_phonemize/
# libespeak-ng shared libraries, but are themselves linked against glibc, not
# musl -- Alpine's gcompat shim is not sufficient for onnxruntime (confirmed:
# it loads and starts, then onnxruntime aborts with an unhandled Ort::Exception
# during model init), so the final stage below uses a glibc base instead. The
# voice model is fetched here too rather than committed to git (binary model
# weights don't belong in repo history) — both land in the image at build
# time, not at container start, so the running service has no runtime
# dependency on anything outside the image. deploy-local.sh already does a
# full local `docker build` on every deploy, so this costs nothing extra.
FROM alpine:3.20 AS piper-fetch
ARG PIPER_VERSION=2023.11.14-2
ARG TARGETARCH
# Voice selection, broken into its path components as the piper-voices
# HuggingFace repo lays them out: <LANG>/<LANG_REGION>/<NAME>/<QUALITY>/.
# Verify this URL shape still matches at implementation time (confirm by
# fetching once by hand) before relying on it in CI.
ARG VOICE_LANG=en
ARG VOICE_LANG_REGION=en_US
ARG VOICE_NAME=lessac
ARG VOICE_QUALITY=medium
RUN apk add --no-cache curl tar && \
    case "$TARGETARCH" in \
      amd64) PIPER_ARCH="x86_64" ;; \
      arm64) PIPER_ARCH="aarch64" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    curl -sSL -o /tmp/piper.tar.gz \
      "https://github.com/rhasspy/piper/releases/download/${PIPER_VERSION}/piper_linux_${PIPER_ARCH}.tar.gz" && \
    tar -xzf /tmp/piper.tar.gz -C /opt && \
    mv /opt/piper /opt/piper-install && \
    mkdir -p /opt/models && \
    VOICE="${VOICE_LANG_REGION}-${VOICE_NAME}-${VOICE_QUALITY}" && \
    VOICE_BASE="https://huggingface.co/rhasspy/piper-voices/resolve/main/${VOICE_LANG}/${VOICE_LANG_REGION}/${VOICE_NAME}/${VOICE_QUALITY}" && \
    curl -sSL -o /opt/models/voice.onnx "${VOICE_BASE}/${VOICE}.onnx" && \
    curl -sSL -o /opt/models/voice.onnx.json "${VOICE_BASE}/${VOICE}.onnx.json"

# whisper.cpp has no binary releases under stable version tags -- only
# under rolling nightly "b<N>" build tags that upstream periodically
# prunes (confirmed: the latest stable-looking tag, v1.9.5, ships no
# binary assets at all). WHISPER_BUILD pins one such tag; if a build ever
# starts failing to fetch it, it's almost certainly because this tag was
# pruned and needs bumping to a current one from
# https://github.com/ggml-org/whisper.cpp/releases, not a sign of a real
# regression. The model is fetched here too, same reasoning as Piper's
# voice model above.
FROM alpine:3.20 AS whisper-fetch
ARG WHISPER_BUILD=b5907
ARG TARGETARCH
ARG WHISPER_MODEL=base.en
RUN apk add --no-cache curl tar && \
    case "$TARGETARCH" in \
      amd64) WHISPER_ARCH="x64" ;; \
      arm64) WHISPER_ARCH="arm64" ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac && \
    curl -sSL -o /tmp/whisper.tar.gz \
      "https://github.com/ggml-org/whisper.cpp/releases/download/${WHISPER_BUILD}/whisper-bin-ubuntu-${WHISPER_ARCH}.tar.gz" && \
    mkdir -p /opt/whisper-install && \
    tar -xzf /tmp/whisper.tar.gz -C /opt/whisper-install --strip-components=1 && \
    mkdir -p /opt/models && \
    curl -sSL -o "/opt/models/whisper-${WHISPER_MODEL}.bin" \
      "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-${WHISPER_MODEL}.bin"

FROM debian:bookworm-slim
COPY --from=piper-fetch /opt/piper-install /opt/piper
ENV PATH="/opt/piper:${PATH}"

COPY --from=piper-fetch /opt/models/ /models/
ENV PIPER_MODEL_PATH=/models/voice.onnx

# whisper-cli's nightly-build binary is glibc-linked like Piper's (confirmed
# via `readelf -V`: needs up to GLIBC_2.34, bookworm ships 2.36) and bundles
# its own libwhisper/libggml*.so next to the binary (resolved via its
# $ORIGIN RUNPATH, confirmed with `readelf -d`), but unlike Piper's tarball
# it does NOT bundle libstdc++/libgomp -- confirmed missing via `ldd` against
# this exact binary. Both must come from the base image explicitly.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libstdc++6 libgomp1 && \
    rm -rf /var/lib/apt/lists/*

COPY --from=whisper-fetch /opt/whisper-install /opt/whisper
ENV PATH="/opt/whisper:${PATH}"

COPY --from=whisper-fetch /opt/models/ /models/
ENV WHISPER_MODEL_PATH=/models/whisper-base.en.bin
ENV WHISPER_BINARY=whisper-cli

COPY --from=server-build /gear-box-server /gear-box-server

EXPOSE 80
ENTRYPOINT ["/gear-box-server"]
